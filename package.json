{
  "name": "greenlogix-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "GreenLogix — B2B Urban Logistics Optimization & ISO 14083 Carbon Accounting Platform",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev:landing": "pnpm --filter @greenlogix/landing dev",
    "build:landing": "pnpm --filter @greenlogix/landing build",
    "preview:landing": "pnpm --filter @greenlogix/landing preview",
    "deploy:landing": "wrangler pages deploy apps/landing/dist --project-name=greenlogix --branch=main --commit-dirty=true",
    "build": "pnpm --filter \"./apps/*\" build"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "wrangler": "^4.126.0"
  }
}
