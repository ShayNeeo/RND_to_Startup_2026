# EcoMiles Local API Environment Variables
GREENLOGIX_DEMO=1
# CORS allowlist, comma-separated. Demo-only "*" applies ONLY when
# GREENLOGIX_DEMO=1 and this var is empty/unset (see T-LOOP-AUTH).
# PROD example (GREENLOGIX_DEMO=0 or unset):
# GREENLOGIX_CORS_ORIGINS=https://fleet.example.vn,https://ops.example.vn
GREENLOGIX_CORS_ORIGINS=
